{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://predictive-gateway.local/schemas/prediction.schema.json",
  "title": "CostPrediction",
  "description": "Output of the ML service: expected computational and monetary cost for a request BEFORE it executes.",
  "type": "object",
  "required": ["requestId", "predictedCostMs", "predictedCloudCostUsd", "costTier", "confidence", "modelVersion"],
  "additionalProperties": false,
  "properties": {
    "requestId": { "type": "string" },
    "predictedCostMs": {
      "type": "number",
      "minimum": 0,
      "description": "Predicted wall-clock execution cost in milliseconds."
    },
    "predictedCloudCostUsd": {
      "type": "number",
      "minimum": 0,
      "description": "Predicted cloud cost in USD, derived from predictedCostMs via the shared cost model."
    },
    "costTier": {
      "type": "string",
      "enum": ["cheap", "medium", "expensive"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modelVersion": {
      "type": "string",
      "description": "e.g. 'heuristic-v1', 'linreg-v1', 'rf-v1'."
    }
  }
}
